# Start pygame
def main():
    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
        
        # Run every tick
        pygame.draw.rect(Surface,background_colour,(0,0,width,height))
        
        # Points[0].pos = [-1,1] # Mouse movement somehow
        for i in range(len(Points)-1):
            Points[i+1].pos = Normalize(Points[i].pos,Points[i+1].pos)

        for point in Points:
            pygame.draw.circle(Surface, point.color, Good2BadCoords(point.pos),8)
        pygame.display.flip()
        
if __name__ == '__main__':
    main()
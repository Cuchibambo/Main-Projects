import pygame
import math
import time
import random

class Point():
    def __init__(self, point2follow, pos, num, color):
        self.point2follow = point2follow
        self.pos = pos
        self.num = num
        self.color = color
    def __str__(self):
        try:
            return f'Point {self.num} on ({self.pos[0]},{self.pos[1]}), follows point {self.point2follow.num}'
        except:
            return f'Point {self.num} on ({self.pos[0]},{self.pos[1]})'

def PrintPointsInfo():
    for i in Points:
        print(i)

def GetNorm(vec):
    return math.sqrt((vec[0]**2)+(vec[1]**2))

def Normalize(pos,target):
    Nextpos = []
    if target == pos:
        return pos
    else:
        target[0] -= pos[0]
        target[1] -= pos[1]
        targetNorm = GetNorm(target)
        Nextpos.append(target[0]/targetNorm)
        Nextpos.append(target[1]/targetNorm)
        Nextpos[0] += pos[0]
        Nextpos[1] += pos[1]
        return Nextpos

def ChooseRandomColor():
    return (math.floor(random.random()*255),math.floor(random.random()*255),math.floor(random.random()*255))

def Good2BadCoords(coords):
    newcords = (
        ((coords[0]+1)*width)//2,
        ((1-coords[1])*height)//2
    )
    return newcords

def Bad2GoodCoords(coords):
    newcords = (
        ((coords[0]*2)//width)-1,
        ((coords[0]*-2)//width)+1
    )
    return newcords

nbPoints = 5
Points = []
Points.append(Point(None, [0,0], 0, ChooseRandomColor()))

for i in range(nbPoints-1):
    Points.append(Point(Points[i],[0,0], i+1, ChooseRandomColor()))

